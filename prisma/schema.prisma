generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MealType {
  MORNING_DRINK
  MORNING_SNACK
  BREAKFAST
  BRUNCH
  AFTERNOON_SNACK
  LUNCH
  EVENING_SNACK
  DINNER
  DESSERT
  DRINK
}

enum DishCategory {
  VEG
  NON_VEG
  EGG
}

model Dish {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String          @unique
  description        String?
  imageUrl           String?
  recipeUrl          String?
  category           DishCategory?
  suggestedMealTypes MealType[]
  createdAt          DateTime        @default(now())
}

model MealPlan {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique
  meals     Json     // e.g. { "BREAKFAST": ["Aloo parantha", "lassi"], "LUNCH": ["Dal makhani"] }
  createdAt DateTime @default(now())
}
